__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
data/

# secrets: never commit API keys
.env
*.env

# credentialed raw data (PhysioNet DUA): manifests and call caches embed full MIMIC-CXR report
# text, which must not be redistributed outside credentialed access. Only aggregate results
# (solo_results.json etc.) are committed.
experiments/mimic_cxr_text/*manifest*.csv
experiments/mimic_cxr_text/results*/call_cache.jsonl
experiments/mimic_cxr_text/results*/*call_cache.jsonl
experiments/mimic_cxr_text/results*/transcripts/

# model-call caches: local reproduction accelerators, not results (can be large)
*_cache.jsonl
# ...but MedMCQA is fully public (no DUA), so its caches ARE committed: the committee arms replay
# keylessly at zero API calls, which is the reproducibility bar for the battery (#291). call_cache
# alone was not enough -- it does not cover the committee arms, so commit the per-arm caches too.
!experiments/medmcqa/results/*_cache.jsonl

# macOS finder metadata
.DS_Store

# battery run logs. No credentialed identifiers, but they echo the full command lines, which carry
# absolute cluster paths including the shared MIMIC-CXR-JPG image root. Nothing to publish, and
# easy to sweep into a commit by accident since they land in the repo root.
*.log

# Per-case rows from the MIMIC-CXR imaging lane. These carry the real MIMIC-CXR dicom/study
# identifiers in `case_id`, which are credentialed PhysioNet data and must not be redistributed.
# Only the summaries (no identifiers) and the de-identified CSVs under results/deid/ (integer
# case_index) are publishable. This was convention-only until a judge_with_image run came within
# one `git add -A` of publishing 417 of them.
experiments/mimic_cxr_image/results/**/*.jsonl
experiments/mimic_cxr_image/results/*.jsonl
